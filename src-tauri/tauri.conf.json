{
  "$schema": "https://raw.githubusercontent.com/nicerdicer/tauri-v2-nightly-schema/main/tauri.schema.json",
  "productName": "Agent Hub",
  "version": "0.6.26",
  "identifier": "com.agent-hub.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Agent Hub",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwNzQyQzE4NDU2QkQ0NDEKUldSQjFHdEZHQ3gwc09Yek52YlZSNEZHckd5cm5aRG1sbTV0ellyWi9OVHc5NzdxTWtLYnkzZ0gK",
      "endpoints": [
        "https://github.com/ssly/agent-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
